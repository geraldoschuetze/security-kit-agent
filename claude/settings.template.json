{
  "permissions": {
    "allow": [
      "Read(/__HOME__/.claude/skills/**)",
      "Bash(trivy:*)",
      "Bash(semgrep:*)",
      "Bash(gitleaks:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash __HOME__/.claude/scripts/gitleaks-gate.sh",
            "timeout": 60,
            "statusMessage": "Verificando segredos antes do commit (gitleaks)..."
          }
        ]
      }
    ]
  }
}
